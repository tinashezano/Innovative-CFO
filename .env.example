# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Public base URL — used to build proposal, booking and signing links that are
# emailed to prospects. Must be reachable by them (use a tunnel in development).
APP_URL="http://localhost:3000"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Password given to the seeded demo accounts. This file is committed, so put
# your real password in .env (which is gitignored) rather than here. To change
# an account's password without re-seeding:
#   npm run set-password -- admin@innovativecfo.co.za 'your-password'
SEED_PASSWORD=""

# Shared secret for the /api/cron/run endpoint (recurring tasks + reminder emails).
CRON_SECRET="change-me-too"

# Guarantees an owner account exists with this password, re-applied on every
# boot. The dependable way in on a host where running Prisma against the
# production database by hand is awkward, and the way back in if the password is
# lost — change OWNER_PASSWORD, redeploy, and it is reset. Remove it once you
# are in and manage people under Settings -> Team.
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_NAME=""

# Set to "true" to switch sign-in off entirely, so the app opens straight onto
# the dashboard. Useful for a demo or a quick test; every visitor becomes the
# owner, so never leave it on for a deployment holding real client data.
AUTH_DISABLED="false"

# ---------------------------------------------------------------------------
# Firm details (shown on proposals, engagement letters and emails)
# ---------------------------------------------------------------------------
FIRM_NAME="Innovative CFO"
FIRM_EMAIL="hello@innovativecfo.co.za"
FIRM_PHONE="+27 00 000 0000"
FIRM_ADDRESS="Johannesburg, South Africa"
DEFAULT_CURRENCY="ZAR"

# ---------------------------------------------------------------------------
# Email (SMTP). Leave DISABLED and every email is written to the Email Log
# instead of being delivered — handy in development.
# ---------------------------------------------------------------------------
EMAIL_MODE="preview"          # preview | smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Innovative CFO <hello@innovativecfo.co.za>"

# ---------------------------------------------------------------------------
# DocuSign — embedded signing for engagement letters.
# DOCUSIGN_MODE=mock renders and signs an in-app engagement letter so the whole
# flow works without credentials. Switch to "live" once your integration key,
# RSA private key and user id are in place.
# ---------------------------------------------------------------------------
DOCUSIGN_MODE="mock"          # mock | live
DOCUSIGN_BASE_PATH="https://demo.docusign.net/restapi"
DOCUSIGN_OAUTH_BASE="https://account-d.docusign.com"
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_USER_ID=""
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_PRIVATE_KEY=""       # PEM, newlines escaped as \n
DOCUSIGN_WEBHOOK_SECRET=""    # HMAC key configured on the DocuSign Connect listener

# ---------------------------------------------------------------------------
# Paystack — payment link on the signed proposal.
# PAYSTACK_MODE=mock issues a local checkout page so you can exercise the flow.
# ---------------------------------------------------------------------------
PAYSTACK_MODE="mock"          # mock | live
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# Google Calendar — free/busy checking on the booking page, and calendar events
# with a Meet link for booked discovery calls. Connected per person under
# Settings -> Integrations; without these the booking page works exactly as
# before, knowing only about calls made in this app.
#
# In the Google Cloud Console: create a project, enable the Google Calendar API,
# create an OAuth client (Web application) and add this redirect URI:
#   <APP_URL>/api/google/callback
# While the consent screen is unverified, add each team member as a Test user.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Reminders — days before due date that reminder emails go out (comma separated),
# plus whether to chase overdue tasks daily.
# ---------------------------------------------------------------------------
REMINDER_OFFSET_DAYS="7,3,1,0"
REMINDER_OVERDUE_ENABLED="true"
