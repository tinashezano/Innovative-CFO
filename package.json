{
  "name": "innovative-cfo",
  "version": "1.0.0",
  "private": true,
  "description": "Accounting firm operations platform: Leads -> Discovery -> Proposal -> Signed & Paid -> Onboarding -> Task Management",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/sync-datasource.ts && prisma generate && tsx scripts/prepare-database.ts && next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "setup": "tsx scripts/bootstrap.ts && prisma generate && prisma db push && npm run db:seed",
    "scheduler": "tsx --conditions=react-server scripts/scheduler.ts",
    "jobs:run": "tsx --conditions=react-server scripts/run-jobs.ts",
    "test": "tsx tests/recurrence.test.ts && tsx tests/format.test.ts && tsx --conditions=react-server tests/security.test.ts && tsx --conditions=react-server tests/workflow.test.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "use:sqlite": "tsx scripts/use-database.ts sqlite",
    "use:postgres": "tsx scripts/use-database.ts postgresql",
    "doctor": "tsx scripts/doctor.ts",
    "set-password": "tsx scripts/set-password.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
